# 后端外部配置示例（真实 .env 不入库，已被 .gitignore 忽略）
# 默认 profile 走 H2 内存库，无需任何配置即可启动；
# 切换 MySQL：设置以下环境变量后以 --spring.profiles.active=mysql 启动。

# MySQL 连接（生产/私有部署用）
DB_URL=jdbc:mysql://localhost:3306/rail_freight?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# 服务端口（可选，默认 8080）
SERVER_PORT=8080
